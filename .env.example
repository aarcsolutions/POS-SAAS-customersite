# SaaS Storefront (customer portal)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Storefront dev server port (Admin uses 3020)
PORT=3021

# Optional: host part of tenant domain (default: localhost)
NEXT_PUBLIC_TENANT_HOST=localhost

# Dev only: force tenant domain for API calls when app port differs from Admin.
# Example: storefront on :3021 but DB maps tenant to localhost:3020 (same as Admin).
# NEXT_PUBLIC_TENANT_DOMAIN=localhost:3020

# File service public URL for uploaded product images
NEXT_PUBLIC_FILE_PUBLIC_BASE_URL=http://localhost:3005
